WITH params AS (
    SELECT DATE(@target_date) AS target_date  -- Or DATE('{{ ds }}') in Airflow
),

-- 1. Determine first-ever seen date per combo across the entire table
combo_metadata AS (
    SELECT 
        CONCAT(marketing_vehicle, '__', device) AS combo_id,
        MIN(DATE(session_start_dt)) AS first_seen_dt
    FROM `your_project.your_dataset.traffic_table`
    GROUP BY combo_id
),

-- 2. Partition-filtered historical slice (440 days lookback)
raw_combos AS (
    SELECT 
        DATE(t.session_start_dt) AS session_start_dt,
        CONCAT(t.marketing_vehicle, '__', t.device) AS combo_id,
        t.marketing_vehicle,
        t.device,
        t.traffic
    FROM `your_project.your_dataset.traffic_table` t
    CROSS JOIN params p
    WHERE DATE(t.session_start_dt) BETWEEN DATE_SUB(p.target_date, INTERVAL 440 DAY) AND p.target_date
),

-- 3. Gather Recent 10 Matching Weekdays (t - 7, 14, ..., 70)
-- Left join guarantees that combos with < 5 past days STILL appear in the output
recent_window AS (
    SELECT 
        curr.session_start_dt,
        curr.combo_id,
        curr.marketing_vehicle,
        curr.device,
        curr.traffic AS actual_traffic,
        ARRAY_AGG(past.traffic IGNORE NULLS) AS recent_vals
    FROM raw_combos curr
    CROSS JOIN params p
    LEFT JOIN raw_combos past
      ON curr.combo_id = past.combo_id
     AND past.session_start_dt IN (
         DATE_SUB(curr.session_start_dt, INTERVAL 7 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 14 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 21 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 28 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 35 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 42 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 49 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 56 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 63 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 70 DAY)
     )
    WHERE curr.session_start_dt = p.target_date
    GROUP BY curr.session_start_dt, curr.combo_id, curr.marketing_vehicle, curr.device, curr.traffic
),

-- 4. Calculate Recent Median & MAD (Handles arrays with < 10 days)
recent_stats AS (
    SELECT 
        r.session_start_dt,
        r.combo_id,
        r.marketing_vehicle,
        r.device,
        r.actual_traffic,
        ARRAY_LENGTH(r.recent_vals) AS past_dow_count,
        
        -- If past_dow_count = 0 (brand new today), default to actual_traffic
        COALESCE(
            (SELECT APPROX_QUANTILES(v, 100)[OFFSET(50)] FROM UNNEST(r.recent_vals) v),
            r.actual_traffic
        ) AS mu_recent,
        
        -- Scaled MAD (if fewer than 3 historical points, default to 0.0)
        CASE 
            WHEN ARRAY_LENGTH(r.recent_vals) >= 3 THEN
                1.4826 * (
                    SELECT APPROX_QUANTILES(
                        ABS(v - (SELECT APPROX_QUANTILES(x, 100)[OFFSET(50)] FROM UNNEST(r.recent_vals) x)), 
                        100
                    )[OFFSET(50)]
                    FROM UNNEST(r.recent_vals) v
                )
            ELSE 0.0
        END AS sigma_raw
    FROM recent_window r
),

-- 5. Prior Year 5-Week Centered Target Window (t - 364 +/- 14d)
ly_target_window AS (
    SELECT 
        curr.session_start_dt,
        curr.combo_id,
        APPROX_QUANTILES(past.traffic, 100)[OFFSET(50)] AS mu_ly_target
    FROM raw_combos curr
    CROSS JOIN params p
    JOIN raw_combos past
      ON curr.combo_id = past.combo_id
     AND past.session_start_dt IN (
         DATE_SUB(curr.session_start_dt, INTERVAL 350 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 357 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 364 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 371 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 378 DAY)
     )
    WHERE curr.session_start_dt = p.target_date
    GROUP BY curr.session_start_dt, curr.combo_id
    HAVING COUNT(past.traffic) >= 3
),

-- 6. Prior Year 10-Week Trailing Base Window (t - 364 - 7k)
ly_base_window AS (
    SELECT 
        curr.session_start_dt,
        curr.combo_id,
        APPROX_QUANTILES(past.traffic, 100)[OFFSET(50)] AS mu_ly_base
    FROM raw_combos curr
    CROSS JOIN params p
    JOIN raw_combos past
      ON curr.combo_id = past.combo_id
     AND past.session_start_dt IN (
         DATE_SUB(curr.session_start_dt, INTERVAL 371 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 378 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 385 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 392 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 399 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 406 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 413 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 420 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 427 DAY),
         DATE_SUB(curr.session_start_dt, INTERVAL 434 DAY)
     )
    WHERE curr.session_start_dt = p.target_date
    GROUP BY curr.session_start_dt, curr.combo_id
    HAVING COUNT(past.traffic) >= 5
),

-- 7. Determine Lifecycle Stage & Compute Expected Baseline (y_hat)
combined_baselines AS (
    SELECT 
        r.session_start_dt,
        r.combo_id,
        r.marketing_vehicle,
        r.device,
        r.actual_traffic,
        r.past_dow_count,
        r.mu_recent,
        r.sigma_raw,
        m.first_seen_dt,
        
        -- Combo Age Calculation
        DATE_DIFF(r.session_start_dt, m.first_seen_dt, DAY) AS combo_age_days,
        
        -- Lifecycle Stage Assignment
        CASE 
            WHEN DATE_DIFF(r.session_start_dt, m.first_seen_dt, DAY) >= 440 THEN 'MATURE'
            WHEN DATE_DIFF(r.session_start_dt, m.first_seen_dt, DAY) >= 90  THEN 'RECENT'
            ELSE 'NEW'
        END AS combo_stage,
        
        -- Clamped secular YoY growth: [-30%, +50%]
        CASE 
            WHEN b.mu_ly_base IS NOT NULL AND b.mu_ly_base > 0 
                THEN LEAST(0.50, GREATEST(-0.30, (r.mu_recent - b.mu_ly_base) / b.mu_ly_base))
            ELSE 0.0 
        END AS g_safe,
        
        -- Expected Baseline Branching:
        -- 1. MATURE: YoY Secular Expansion
        -- 2. RECENT / NEW: Current Trend (mu_recent)
        CASE 
            WHEN DATE_DIFF(r.session_start_dt, m.first_seen_dt, DAY) >= 440 
                 AND t.mu_ly_target IS NOT NULL 
                 AND b.mu_ly_base IS NOT NULL 
                 AND b.mu_ly_base > 0 
                THEN t.mu_ly_target * (1 + LEAST(0.50, GREATEST(-0.30, (r.mu_recent - b.mu_ly_base) / b.mu_ly_base)))
            ELSE r.mu_recent
        END AS expected_traffic
    FROM recent_stats r
    LEFT JOIN combo_metadata m 
      ON r.combo_id = m.combo_id
    LEFT JOIN ly_target_window t
      ON r.session_start_dt = t.session_start_dt AND r.combo_id = t.combo_id
    LEFT JOIN ly_base_window b
      ON r.session_start_dt = b.session_start_dt AND r.combo_id = b.combo_id
),

-- 8. Dynamic Volume Tiers
tiered_parameters AS (
    SELECT 
        *,
        CASE 
            WHEN expected_traffic >= 20000000 THEN 0.02
            WHEN expected_traffic >= 1000000  THEN 0.04
            WHEN expected_traffic >= 100000   THEN 0.08
            ELSE 0.12
        END AS floor_pct,
        CASE WHEN expected_traffic < 100000 THEN 4.0 ELSE 3.5 END AS k_sigma,
        CASE 
            WHEN expected_traffic >= 20000000 THEN 0.05
            WHEN expected_traffic >= 1000000  THEN 0.08
            WHEN expected_traffic >= 100000   THEN 0.15
            ELSE 0.20
        END AS delta_pct
    FROM combined_baselines
),

-- 9. Compute Threshold Boundaries
final_scoring AS (
    SELECT 
        session_start_dt,
        combo_id,
        marketing_vehicle,
        device,
        combo_age_days,
        combo_stage,
        past_dow_count,
        actual_traffic,
        ROUND(expected_traffic, 0) AS expected_traffic,
        ROUND(g_safe, 4) AS yoy_growth_applied,
        
        ROUND(GREATEST(sigma_raw, floor_pct * expected_traffic), 2) AS sigma_stable,
        ROUND(expected_traffic + (k_sigma * GREATEST(sigma_raw, floor_pct * expected_traffic)), 0) AS upper_threshold,
        ROUND(GREATEST(0.0, expected_traffic - (k_sigma * GREATEST(sigma_raw, floor_pct * expected_traffic))), 0) AS lower_threshold,
        
        ROUND(expected_traffic * (1 + delta_pct), 0) AS min_spike_volume,
        ROUND(expected_traffic * (1 - delta_pct), 0) AS max_drop_volume
    FROM tiered_parameters
)

-- 10. Final Decision Gate with Lifecycle Stage Protection
SELECT 
    session_start_dt,
    combo_id,
    marketing_vehicle,
    device,
    combo_age_days,
    combo_stage,
    past_dow_count,
    actual_traffic,
    expected_traffic,
    upper_threshold,
    lower_threshold,
    
    -- Spikes: Only active for MATURE and RECENT combos
    CASE 
        WHEN combo_stage = 'NEW' THEN FALSE
        ELSE (actual_traffic > upper_threshold AND actual_traffic > min_spike_volume)
    END AS is_spike,
    
    -- Drops: Only active for MATURE and RECENT combos
    CASE 
        WHEN combo_stage = 'NEW' THEN FALSE
        ELSE ((actual_traffic < lower_threshold AND actual_traffic < max_drop_volume) 
              OR (actual_traffic = 0 AND expected_traffic >= 100))
    END AS is_drop,
    
    -- Consolidated Anomaly Flag
    CASE 
        WHEN combo_stage = 'NEW' THEN FALSE
        WHEN (actual_traffic > upper_threshold AND actual_traffic > min_spike_volume) THEN TRUE
        WHEN (actual_traffic < lower_threshold AND actual_traffic < max_drop_volume) THEN TRUE
        WHEN (actual_traffic = 0 AND expected_traffic >= 100) THEN TRUE
        ELSE FALSE
    END AS is_anomaly

FROM final_scoring
ORDER BY combo_stage ASC, actual_traffic DESC;
